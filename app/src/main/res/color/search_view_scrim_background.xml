<?xml version="1.0" encoding="utf-8"?>
<!-- UI-009: real RenderEffect blur (UI-007) caused visible jank on the SearchBar<->SearchView
     morph animation because it recomputed every frame while the panel was transforming. Replaced
     with a single tonal-M3 scrim on all API levels - no blur to compensate for, so one opacity
     (near-opaque) does the whole "hide the lens grid" job cheaply, and the exact same
     ?attr/colorSurfaceContainerHigh value is reused for the status/navigation bar color
     (ActHome.setSearchSystemBarsHarmonized) so the whole screen reads as one continuous surface. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:alpha="0.96"
        android:color="?attr/colorSurfaceContainerHigh" />
</selector>
