<?xml version="1.0" encoding="utf-8"?>
<!-- FEAT-007: selection indicator is a soft pastel tonal-container fill (Material 3's
     own "container" role, already used elsewhere in this app for pill/badge surfaces) —
     no stroke border, matching the design feedback that a hard stroke read as harsh and
     inconsistent with this app's generally pastel Material You palette. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="?attr/colorPrimaryContainer" />
    <item android:color="?attr/colorSurfaceContainerLow" />
</selector>
