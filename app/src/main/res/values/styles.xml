<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- App Theme -->
    <style name="AppTheme" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <!-- UI-005 follow-up: colorAccent is intentionally NOT set here. Material3's own base
             theme already maps colorAccent -> ?attr/colorSecondary; DynamicColors patches the
             modern colorSecondary role but never re-patches the legacy colorAccent bridge attr
             directly, so a static override here would permanently shadow the dynamic value
             (this was a live bug: bg_button_gradient_ripple's colorAccent half stayed the old
             static red on every device, dynamic color or not). Set colorSecondary instead, as
             the pre-Android-12 static fallback; colorAccent then just inherits it as normal. -->
        <item name="colorSecondary">@color/colorAccent</item>
        <!-- Material You: transparent system bars so the dynamic-colored toolbar/content shows
             through instead of the static colorPrimaryDark this theme still declares for
             back-compat (edge-to-edge is already enabled via UIUtils.setupEdgeToEdge1). -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
    </style>

    <!-- Home (Launcher) Theme -->
    <style name="HomeTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
<!--        <item name="android:windowIsTranslucent">false</item>-->
<!--        <item name="android:windowBackground">@drawable/startup</item>-->

        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <!-- See AppTheme above for why colorAccent is not set directly here. -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="android:navigationBarColor">@android:color/transparent
        </item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>

    <!-- Settings Theme -->
    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- App Bar Themes -->
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3.Light">
        <item name="actionOverflowMenuStyle">@style/RoundedOverflowMenuStyle</item>
    </style>

    <style name="LightAlertDialogCustom" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:background">@color/colorWhite</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textColorPrimary">@color/colorBlack</item>
        <item name="android:textColorAlertDialogListItem">?attr/colorPrimary</item>
    </style>

    <!-- Popup Menu Style -->
    <style name="RoundedPopupMenuStyle" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>

    <!-- Overflow Menu Style -->
    <style name="RoundedOverflowMenuStyle" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>

    <!-- Popup Menu Theme with Rounded Background -->
    <style name="PopupMenuTheme" parent="Theme.AppCompat.Light">
        <item name="popupMenuStyle">@style/RoundedPopupMenuStyle</item>
    </style>

    <!-- UI-005: ThemeOverlay (not a standalone Theme) so this inherits colorPrimary/colorAccent
         from the activity context it wraps (MaterialAlertDialogBuilder(activity, this)) instead
         of re-declaring them statically - the activity's theme is already dynamic-color-patched
         by DynamicColors.applyToActivitiesIfAvailable(), which only patches Activities, not a
         standalone Theme.* resource used directly as a dialog theme. -->
    <style name="MaterialYouDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="dialogCornerRadius">28dp</item>
        <item name="buttonBarButtonStyle">@style/DialogButtonNoAllCapsStyle</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButtonNoAllCapsStyle</item>
    </style>

    <!-- Dialog Button Style to keep only first letter capitalized -->
    <style name="DialogButtonNoAllCapsStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- UI-005: ThemeOverlay.Material3.BottomSheetDialog (not the legacy Theme.Design one) so
         this bottom sheet inherits the dynamic-color-patched colorPrimary from the activity
         context it wraps, instead of Theme.Design's fixed pre-Material3 defaults. -->
    <style name="TransBottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/TransBottomSheetStyle</item>
    </style>
    <style name="TransBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
