<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- App Theme (Material 3 DayNight) -->
    <style name="AppTheme" parent="Theme.Material3.DayNight">
        <!-- Material 3 Dynamic / Fallback Color Roles -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>

        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/colorOnSecondaryContainer</item>

        <item name="colorTertiary">@color/colorTertiary</item>
        <item name="colorOnTertiary">@color/colorOnTertiary</item>
        <item name="colorTertiaryContainer">@color/colorTertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/colorOnTertiaryContainer</item>

        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>

        <item name="colorSurfaceContainerLowest">@color/colorSurfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/colorSurfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/colorSurfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/colorSurfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/colorSurfaceContainerHighest</item>

        <item name="colorOutline">@color/colorOutline</item>
        <item name="colorOutlineVariant">@color/colorOutlineVariant</item>

        <!-- Material You: transparent system bars with automatic contrast -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>

        <!-- Material 3 Component default styles -->
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Filled</item>

        <!-- FEAT-007: theme the multi-select contextual action bar to match this app's own
             toolbar (?attr/colorPrimary/colorOnPrimary, same Material You dynamic-color
             tokens the toolbar already uses) instead of AppCompat's default light bar —
             fixes a real color mismatch found live: an untouched CAB rendered as a stark
             light bar directly above this app's own dark, dynamically-tinted toolbar. -->
        <item name="actionModeStyle">@style/AppTheme.ActionMode</item>
        <item name="actionModeCloseButtonStyle">@style/AppTheme.ActionMode.CloseButton</item>
    </style>

    <!-- Home (Launcher) Theme -->
    <style name="HomeTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>
        <item name="colorSurfaceContainerHigh">@color/colorSurfaceContainerHigh</item>
        <item name="colorOutline">@color/colorOutline</item>
        <item name="colorOutlineVariant">@color/colorOutlineVariant</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>

    <!-- Settings Theme -->
    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- App Bar Themes -->
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />

    <!-- FEAT-007: multi-select contextual action bar, matching AppTheme.AppBarOverlay's
         same dark-toolbar treatment so it reads as one continuous surface, not a foreign
         light bar. -->
    <style name="AppTheme.ActionMode" parent="Widget.AppCompat.ActionMode">
        <item name="background">?attr/colorPrimary</item>
        <item name="titleTextStyle">@style/AppTheme.ActionMode.Title</item>
    </style>

    <style name="AppTheme.ActionMode.Title" parent="TextAppearance.AppCompat.Widget.ActionMode.Title">
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="AppTheme.ActionMode.CloseButton" parent="Widget.AppCompat.ActionButton.CloseMode">
        <item name="tint">?attr/colorOnPrimary</item>
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="actionOverflowMenuStyle">@style/RoundedOverflowMenuStyle</item>
    </style>

    <!-- Popup Menu Text Appearance -->
    <style name="PopupMenuTextAppearance" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Popup Menu Style -->
    <style name="RoundedPopupMenuStyle" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:itemTextAppearance">@style/PopupMenuTextAppearance</item>
    </style>

    <!-- Overflow Menu Style -->
    <style name="RoundedOverflowMenuStyle" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:itemTextAppearance">@style/PopupMenuTextAppearance</item>
    </style>

    <!-- Popup Menu Theme with Rounded Background -->
    <style name="PopupMenuTheme" parent="ThemeOverlay.Material3">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="popupMenuStyle">@style/RoundedPopupMenuStyle</item>
    </style>

    <!-- Material You Dialog Theme (ThemeOverlay inheriting dynamic tokens from wrapped Activity) -->
    <style name="MaterialYouDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Material3.Corner.ExtraLarge</item>
        <item name="buttonBarButtonStyle">@style/DialogButtonNoAllCapsStyle</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButtonNoAllCapsStyle</item>
    </style>

    <!-- Dialog Button Style without AllCaps -->
    <style name="DialogButtonNoAllCapsStyle" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Material 3 BottomSheetDialog -->
    <style name="TransBottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/TransBottomSheetStyle</item>
    </style>
    <style name="TransBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Empty Quick Action Tile in Search View -->
    <style name="EmptyQuickActionTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="drawableTint">?attr/colorPrimary</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>
