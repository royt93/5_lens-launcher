<?xml version="1.0" encoding="utf-8"?>
<!-- SEARCH-003: one app-shortcut chip, inflated up to MAX_SHORTCUTS times into
     R.id.llSearchResultShortcuts per search result row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_search_shortcut_chip"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">

    <ImageView
        android:id="@+id/ivShortcutIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tvShortcutLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
