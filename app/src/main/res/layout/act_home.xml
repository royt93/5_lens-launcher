<?xml version="1.0" encoding="utf-8"?>
<!-- MergeRootFrame doesn't apply here: this layout is set directly via
     ActHome.setContentView(R.layout.act_home), not inflated with <include> into a
     parent, so a <merge> root would crash (there's no parent ViewGroup to merge into). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <com.mckimquyen.views.LensView
        android:id="@+id/lensViews"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:hapticFeedbackEnabled="true"
        android:visibility="invisible"
        tools:visibility="visible" />

    <me.zhanghai.android.materialprogressbar.MaterialProgressBar
        android:id="@+id/progressBarHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <!-- Material You: real SearchBar->SearchView morph, replaces the old plain pill + CardView.
         setupWithSearchBar() (ActHome.setupViews) wires the tap-to-expand animation and back-
         press collapse; CoordinatorLayout is required for app:layout_anchor to work. -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/searchCoordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.search.SearchBar
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:hint="@string/search_apps_hint" />

        <com.google.android.material.search.SearchView
            android:id="@+id/searchView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/search_apps_hint"
            app:backgroundTint="@color/search_view_scrim_background"
            app:layout_anchor="@id/searchBar">

            <!-- UI-002: SearchView's own background is dimmed to 50% alpha at runtime
                 (ActHome.setupViews) so the fisheye grid stays partially visible behind it; the
                 result list lives in this opaque card so text contrast never depends on what's
                 behind the scrim. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- SEARCH-002: calculator / unit conversion / timer / battery % / settings
                         deep-link quick action, shown above normal app results when the typed
                         query matches one of those patterns. -->
                    <LinearLayout
                        android:id="@+id/quickActionRow"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tvQuickActionLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            tools:text="12*7" />

                        <TextView
                            android:id="@+id/tvQuickActionValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold"
                            tools:text="= 84" />
                    </LinearLayout>

                    <View
                        android:id="@+id/quickActionDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorDivider"
                        android:visibility="gone" />

                    <!-- UI-009: recent-apps section header, icon+caption pattern so the three
                         search states (no data / recent data / valid results) are visually
                         distinct sections instead of an unlabeled list. -->
                    <LinearLayout
                        android:id="@+id/recentHeader"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_history_24dp"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/recent_apps"
                            android:textColor="?attr/colorPrimary"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btClearSearchHistory"
                            style="?attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="@string/clear_recent_apps"
                            android:textAllCaps="false" />
                    </LinearLayout>

                    <!-- UI-009: results section header, shown only for a non-empty query with
                         matches (distinct from recentHeader, which covers the blank-query state).
                         Single TextView + compound drawable (not icon+TextView in a LinearLayout)
                         per lint's UseCompoundDrawables. -->
                    <TextView
                        android:id="@+id/resultsSectionHeader"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/search_results_section"
                        app:drawableStartCompat="@drawable/ic_search_24dp"
                        app:drawableTint="?attr/colorPrimary"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- UI-009: empty/no-match state - icon above text via compound drawable
                         (was a nested ImageView+TextView) per lint's UseCompoundDrawables. -->
                    <TextView
                        android:id="@+id/tvNoSearchResults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:gravity="center"
                        android:minHeight="120dp"
                        android:padding="16dp"
                        android:text="@string/no_apps_found"
                        android:visibility="gone"
                        app:drawableTint="?attr/colorOutline"
                        app:drawableTopCompat="@drawable/ic_search_24dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSearchResults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="true"
                        android:overScrollMode="ifContentScrolls" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.search.SearchView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</FrameLayout>
