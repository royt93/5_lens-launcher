<?xml version="1.0" encoding="utf-8"?>
<!-- CoordinatorLayout is the Material SearchBar/SearchView host and also lets the collapsed
     launcher behave like a top-search + app-grid column instead of a full-screen overlay stack. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <com.mckimquyen.views.LensView
        android:id="@+id/lensViews"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:hapticFeedbackEnabled="true"
        android:layout_marginTop="72dp"
        android:visibility="invisible"
        tools:visibility="visible" />

    <!-- FEAT-003: Accessible List Mode RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHomeAppList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="72dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/home_list_padding_horizontal"
        android:paddingBottom="16dp"
        android:visibility="gone"
        tools:visibility="gone" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBarHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        app:indicatorColor="?attr/colorPrimary" />

    <!-- Material You: real SearchBar->SearchView morph, replaces the old plain pill + CardView.
         The collapsed launcher is now a top-search + app-grid column: LensView gets a runtime
         top margin equal to system-bar inset + SearchBar height + spacing, so icons never sit
         invisibly below the search affordance. SearchView remains full-screen only while open. -->
    <com.google.android.material.search.SearchBar
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_search_height"
        android:minHeight="0dp"
        android:layout_gravity="top"
        android:layout_marginHorizontal="@dimen/home_search_margin_horizontal"
        android:layout_marginTop="@dimen/home_search_top_margin"
        android:hint="@string/search_apps_hint" />

    <com.google.android.material.search.SearchView
        android:id="@+id/searchView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:hint="@string/search_apps_hint"
        app:backgroundTint="@color/search_view_scrim_background"
        app:layout_anchor="@id/searchBar">

            <!-- UI-011: content sits directly on SearchView's own scrim - no secondary
                 MaterialCardView. A rounded card nested inside a panel that already has its own
                 full-bleed scrim background read as "a frame inside a frame" (owner feedback);
                 the official Material3 full-screen-search spec puts content straight on the
                 panel. Text contrast no longer depends on an opaque card because the scrim
                 itself (res/color/search_view_scrim_background.xml) is near-opaque. -->
            <!-- UI-015: match_parent (was wrap_content) so rvSearchResults below can use
                 layout_weight to fill all remaining height instead of a hand-computed pixel cap -
                 the old cap (64dp/row, capped at 384dp = 6 rows) left most of the screen as dead
                 scrim space once UI-011's all-apps fallback could show dozens of apps. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <!-- SEARCH-002: calculator / unit conversion / timer / battery % / settings
                     deep-link quick action, shown above normal app results when the typed
                     query matches one of those patterns. -->
                <LinearLayout
                    android:id="@+id/quickActionRow"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <!-- UI-016 fix: was legible but too understated (no explicit textColor/size/
                         weight) to actually notice against a busy dynamic-color scrim - confirmed
                         via a zoomed screenshot crop that the text WAS rendering correctly the
                         whole time, just easy to miss at a glance (owner + Claude both initially
                         read it as "broken"). -->
                    <TextView
                        android:id="@+id/tvQuickActionLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="12*7" />

                    <TextView
                        android:id="@+id/tvQuickActionValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        tools:text="= 84" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/quickActionDivider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="?attr/colorOutlineVariant"
                    android:visibility="gone" />

                <!-- SEARCH-005: explicit contact-search row. It is separate from the app-result
                     RecyclerView so contact data is never mixed into the persisted App model or
                     search history. -->
                <LinearLayout
                    android:id="@+id/contactActionRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvContactResultName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="Jane Nguyen" />

                        <TextView
                            android:id="@+id/tvContactResultPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"
                            tools:text="+84 912 345 678" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btContactCall"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/contact_search_call" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btContactMessage"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/contact_search_message" />
                </LinearLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/contactActionDivider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dividerColor="?attr/colorOutlineVariant"
                    android:visibility="gone" />

                <!-- UI-011: permanent quick-action shortcuts on a blank query. Calculator/unit
                     conversion/timer prefill a working example into the search box (the
                     contextual quickActionRow above then does the real execution, same as if the
                     user typed it) instead of each tile needing its own execution path; wifi/
                     battery act on plain single-word triggers so prefilling them behaves the
                     same way and needs no special-casing. -->
                <LinearLayout
                    android:id="@+id/llEmptyQuickActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tileCalculator"
                        style="@style/EmptyQuickActionTile"
                        android:text="@string/quick_action_calculator_label"
                        app:drawableTopCompat="@drawable/ic_calculate_24dp" />

                    <TextView
                        android:id="@+id/tileUnitConvert"
                        style="@style/EmptyQuickActionTile"
                        android:text="@string/quick_action_unit_label"
                        app:drawableTopCompat="@drawable/ic_swap_horiz_24dp" />

                    <TextView
                        android:id="@+id/tileTimer"
                        style="@style/EmptyQuickActionTile"
                        android:text="@string/quick_action_timer_label"
                        app:drawableTopCompat="@drawable/ic_timer_24dp" />

                    <TextView
                        android:id="@+id/tileBattery"
                        style="@style/EmptyQuickActionTile"
                        android:text="@string/quick_action_battery_label"
                        app:drawableTopCompat="@drawable/ic_battery_24dp" />

                    <TextView
                        android:id="@+id/tileWifi"
                        style="@style/EmptyQuickActionTile"
                        android:text="@string/quick_action_wifi_label"
                        app:drawableTopCompat="@drawable/ic_wifi_24dp" />
                </LinearLayout>

                <!-- UI-009: recent-apps section header, icon+caption pattern so the search
                     states are visually distinct sections instead of an unlabeled list. -->
                <LinearLayout
                    android:id="@+id/recentHeader"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_history_24dp"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/recent_apps"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btClearSearchHistory"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/clear_recent_apps" />
                </LinearLayout>

                <!-- UI-011: shown when a blank query has no recent/favorite apps to surface -
                     the fallback list below is the full app list instead of leaving the panel
                     empty. -->
                <TextView
                    android:id="@+id/allAppsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/all_apps_section"
                    app:drawableStartCompat="@drawable/ic_apps_24dp"
                    app:drawableTint="?attr/colorPrimary"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- UI-009: results section header, shown only for a non-empty query with
                     matches (distinct from recentHeader, which covers the blank-query state).
                     Single TextView + compound drawable (not icon+TextView in a LinearLayout)
                     per lint's UseCompoundDrawables. -->
                <TextView
                    android:id="@+id/resultsSectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/search_results_section"
                    app:drawableStartCompat="@drawable/ic_search_24dp"
                    app:drawableTint="?attr/colorPrimary"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- UI-009: empty/no-match state - icon above text via compound drawable
                     (was a nested ImageView+TextView) per lint's UseCompoundDrawables. Now only
                     reachable for a typed query with zero matches, or the (near-impossible) case
                     of a device with no visible apps at all - UI-011's all-apps fallback covers
                     every other blank-query case. -->
                <TextView
                    android:id="@+id/tvNoSearchResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:minHeight="120dp"
                    android:padding="16dp"
                    android:text="@string/no_apps_found"
                    android:visibility="gone"
                    app:drawableTint="?attr/colorOutline"
                    app:drawableTopCompat="@drawable/ic_search_24dp" />

                <!-- SEARCH-006: shown only when a typed query has zero local matches (apps,
                     shortcuts, quick actions all empty) - never alongside real local results. -->
                <TextView
                    android:id="@+id/tvWebSearchFallback"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="16dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_search_24dp"
                    app:drawableTint="?attr/colorPrimary"
                    tools:text="Search the web for &quot;abcxyz&quot;"
                    tools:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSearchResults"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:nestedScrollingEnabled="true"
                    android:overScrollMode="ifContentScrolls" />
            </LinearLayout>
    </com.google.android.material.search.SearchView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
