<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lensGroupHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp">

    <ImageView
        android:id="@+id/tvLensGroupExpanded"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/lens_group_toggle"
        android:padding="12dp"
        android:src="@drawable/ic_expand_more_24dp"
        app:tint="?attr/colorOnSurfaceVariant" />

    <ImageView
        android:id="@+id/ivLensGroupIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_folder_24dp"
        app:tint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/tvLensGroupHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/tvLensGroupCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_lens_group_count"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
