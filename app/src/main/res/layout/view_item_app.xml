<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cvAppContainer"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    android:foreground="?android:attr/selectableItemBackground"
    card_view:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    card_view:cardCornerRadius="16dp"
    card_view:cardElevation="0dp"
    card_view:strokeWidth="0dp"
    card_view:cardUseCompatPadding="false"
    android:layoutDirection="locale"
    tools:ignore="HardcodedText,contentDescription">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingVertical="4dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivAppIcon"
            android:layout_width="@dimen/width_app_icon"
            android:layout_height="@dimen/width_app_icon"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_app_icon_circle"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_launcher_round" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAppLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin_app"
            android:layout_toStartOf="@+id/btAppLock"
            android:layout_toEndOf="@+id/ivAppIcon"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="AppName" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAppOrganization"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvAppLabel"
            android:layout_marginStart="@dimen/margin_app"
            android:layout_toStartOf="@id/btAppLock"
            android:layout_toEndOf="@id/ivAppIcon"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="Favorite • Work • Pinned first"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btAppLock"
            android:layout_width="@dimen/width_app_icon"
            android:layout_height="@dimen/height_app_action_button"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/ivAppHide"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            card_view:tint="?attr/colorOnSurfaceVariant"
            tools:src="@drawable/ic_lock_24dp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivAppHide"
            android:layout_width="@dimen/width_app_icon"
            android:layout_height="@dimen/height_app_action_button"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/ivAppMenu"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/ic_visibility_24dp"
            card_view:tint="?attr/colorOnSurfaceVariant" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivAppMenu"
            android:layout_width="@dimen/width_app_icon"
            android:layout_height="@dimen/height_app_action_button"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert_24dp"
            card_view:tint="?attr/colorOnSurfaceVariant" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
