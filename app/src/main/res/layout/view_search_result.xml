<?xml version="1.0" encoding="utf-8"?>
<!-- SEARCH-003: outer container is now vertical so an optional app-shortcuts row can render
     below the main app row within the same list item, without needing a second RecyclerView
     item type. Click/long-click stay on the inner main row only - the shortcuts row has its
     own per-chip click targets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Overdraw is a lint false positive here: selectableItemBackground is a ripple drawable —
         fully transparent except during a touch ripple — not an opaque fill, so there is no real
         double-paint. -->
    <LinearLayout
        android:id="@+id/llSearchResultMainRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        tools:ignore="Overdraw"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/ivSearchResultIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            tools:src="@drawable/ic_launcher_round" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSearchResultLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBody1"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Camera" />

            <TextView
                android:id="@+id/tvSearchResultPackage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textSize="12sp"
                tools:text="com.android.camera" />
        </LinearLayout>
    </LinearLayout>

    <!-- SEARCH-003: app-published shortcuts (e.g. "New message"), populated programmatically in
         SearchResultAdapter.bind() since there are at most a few per app - not worth a nested
         RecyclerView. Gone entirely when the app publishes none. -->
    <LinearLayout
        android:id="@+id/llSearchResultShortcuts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="60dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
