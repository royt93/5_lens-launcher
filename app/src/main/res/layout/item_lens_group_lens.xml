<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lensGroupRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbLensGroupRow"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivLensGroupRowIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_color_lens_24dp"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/tvLensGroupRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingVertical="12dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/tvLensGroupActive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_lens_group_active"
        android:drawablePadding="4dp"
        app:drawableStartCompat="@drawable/ic_done_chip_16dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="@string/lens_group_active"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btLensGroupMore"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/lens_group_lens_options"
        android:src="@drawable/ic_more_vert_24dp"
        app:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
