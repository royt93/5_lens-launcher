<?xml version="1.0" encoding="utf-8"?>
<!-- Overdraw is a lint false positive here: selectableItemBackgroundBorderless is a ripple
     drawable — fully transparent except during a touch ripple — not an opaque fill, so there is
     no real double-paint. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:background="?android:attr/selectableItemBackgroundBorderless"
    tools:ignore="Overdraw"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Flag -->
    <TextView
        android:id="@+id/tvFlag"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:textSize="26sp" />

    <!-- Name + English Name -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLanguageName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorValue"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLanguageEnglishName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorAppTint"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Selected Check with animated scale -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivSelected"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_done_24dp"
        app:tint="?attr/colorPrimary"
        android:visibility="gone" />

</LinearLayout>
