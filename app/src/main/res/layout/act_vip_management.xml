<?xml version="1.0" encoding="utf-8"?>
<!-- Overdraw: same reasoning as act_settings.xml — this activity shares AppTheme.NoActionBar
     with ActAbout/SuperWebViewActivity, whose layouts rely on that theme's default background,
     so moving colorPrimary into the theme instead of painting it here is out of scope (would
     need verifying those other screens don't visually regress). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPrimary"
    tools:ignore="Overdraw">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:colorBackground"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/AppTheme.PopupOverlay" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content (NestedScrollView) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="16dp">

            <!-- SECTION 1: Header Status and Info -->
            <LinearLayout
                android:id="@+id/section1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. Status header / Hero card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStatusHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@android:color/transparent">

                    <FrameLayout
                        android:id="@+id/layoutStatusHeaderBg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_vip_card_gradient">

                        <!-- Background decorative star 1 (Top Left) -->
                        <ImageView
                            android:id="@+id/imgDecoStarLeft"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_star_24dp"
                            android:alpha="0.10"
                            android:rotation="-20"
                            android:layout_gravity="start|top"
                            android:layout_marginStart="-16dp"
                            android:layout_marginTop="-16dp"
                            app:tint="#FFFFFF" />

                        <!-- Background decorative star 2 (Bottom Right) -->
                        <ImageView
                            android:id="@+id/imgDecoStarRight"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_star_24dp"
                            android:alpha="0.10"
                            android:rotation="35"
                            android:layout_gravity="end|bottom"
                            android:layout_marginEnd="-24dp"
                            android:layout_marginBottom="-24dp"
                            app:tint="#FFFFFF" />

                        <!-- Foreground content -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="32dp"
                            android:gravity="center">

                            <!-- Premium Pill Badge -->
                            <TextView
                                android:id="@+id/tvStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_vip_pill_badge"
                                android:backgroundTint="#15FFFFFF"
                                tools:text="LENS MEMBER"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.15"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:layout_marginBottom="16dp" />

                            <ImageView
                                android:id="@+id/imgCrown"
                                android:layout_width="96dp"
                                android:layout_height="96dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_star_24dp"
                                app:tint="#FF9800"
                                android:layout_marginBottom="16dp" />

                            <TextView
                                android:id="@+id/tvStatusTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FFFFFF"
                                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                                android:textStyle="bold"
                                android:text="@string/vip_free_user" />

                            <TextView
                                android:id="@+id/tvStatusSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#B0BEC5"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:layout_marginTop="8dp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Active VIP info -->
                <LinearLayout
                    android:id="@+id/layoutActiveVipInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <!-- 2. Activation date row -->
                    <TextView
                        android:id="@+id/tvActivationDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="4dp" />

                    <!-- 3. Expiry date row -->
                    <TextView
                        android:id="@+id/tvExpiryDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="8dp" />

                    <!-- 4. Progress bar (elapsed) -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressVip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:trackCornerRadius="4dp"
                        app:indicatorColor="?attr/colorPrimary"
                        app:trackColor="?attr/colorSurfaceVariant"
                        android:max="100" />

                    <!-- 5. Countdown text -->
                    <TextView
                        android:id="@+id/tvCountdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="16dp" />

                    <!-- 12. Active VIP card (single-entry) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp"
                            android:gravity="center_vertical"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <TextView
                                android:id="@+id/tvActiveVipLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:fontFamily="sans-serif-medium" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRevokeVip"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:textColor="?attr/colorError"
                                app:rippleColor="?attr/colorError"
                                android:text="@string/vip_revoke_all_button"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textStyle="bold"
                                android:textAllCaps="false"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:minWidth="0dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- VIP Features List (Spotify/YouTube Premium style) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:background="@drawable/bg_glass_card_rect">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/vip_features_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginBottom="16dp" />

                        <!-- Feature 1: No Ads -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <ImageView
                                android:id="@+id/imgFeatureNoAds"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_star_24dp"
                                app:tint="?attr/colorPrimary"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent" />

                            <TextView
                                android:id="@+id/tvFeatureNoAdsTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="@string/vip_feature_no_ads_title"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"
                                app:layout_constraintStart_toEndOf="@id/imgFeatureNoAds"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="@string/vip_feature_no_ads_desc"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintStart_toEndOf="@id/imgFeatureNoAds"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tvFeatureNoAdsTitle"
                                app:layout_constraintBottom_toBottomOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- Feature 2: High Performance / Premium Customization -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <ImageView
                                android:id="@+id/imgFeatureCustomization"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_color_lens_24dp"
                                app:tint="?attr/colorPrimary"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent" />

                            <TextView
                                android:id="@+id/tvFeatureCustomizationTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="@string/vip_feature_customization_title"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"
                                app:layout_constraintStart_toEndOf="@id/imgFeatureCustomization"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="@string/vip_feature_customization_desc"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintStart_toEndOf="@id/imgFeatureCustomization"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tvFeatureCustomizationTitle"
                                app:layout_constraintBottom_toBottomOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- Feature 3: Priority Support -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:id="@+id/imgFeatureSupport"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_feedback_24dp"
                                app:tint="?attr/colorPrimary"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent" />

                            <TextView
                                android:id="@+id/tvFeatureSupportTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="@string/vip_feature_support_title"
                                android:textAppearance="?attr/textAppearanceTitleSmall"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"
                                app:layout_constraintStart_toEndOf="@id/imgFeatureSupport"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="@string/vip_feature_support_desc"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                app:layout_constraintStart_toEndOf="@id/imgFeatureSupport"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tvFeatureSupportTitle"
                                app:layout_constraintBottom_toBottomOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- SECTION 2: Key Verification (Search-bar style) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/section2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <EditText
                        android:id="@+id/edtVipKey"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/vip_redeem_label"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:textColor="?attr/colorOnSurface"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:inputType="textCapCharacters"
                        android:importantForAutofill="no"
                        android:drawableStart="@drawable/ic_confirmation_number"
                        android:drawableTint="?attr/colorOnSurfaceVariant"
                        android:drawablePadding="12dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="12dp"
                        android:maxLines="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActivateVipKey"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/vip_redeem_button"
                        android:enabled="false"
                        app:cornerRadius="24dp"
                        android:textStyle="bold"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textAllCaps="false"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 3: Ads, IAP and Footer -->
            <LinearLayout
                android:id="@+id/section3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_marginTop="8dp">

                <!-- 7. Button "Xem quảng cáo → 3 ngày VIP" -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:padding="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWatchAdVip"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_play_circle"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconTint="@android:color/white"
                        android:background="@drawable/bg_vip_button_green"
                        android:text="@string/vip_watch_ad_3d"
                        android:textColor="@android:color/white"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textStyle="bold"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:textAllCaps="false" />
                </FrameLayout>

                <!-- 8. Buy 30-day VIP (disabled) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuy30d"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    app:icon="@drawable/ic_card_giftcard"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconTint="?attr/colorOnSurfaceVariant"
                    android:textColor="?attr/colorOnSurface"
                    android:enabled="false"
                    android:layout_marginTop="12dp"
                    app:cornerRadius="16dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp"
                    android:text="@string/vip_buy_30d_locked"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:textAllCaps="false" />

                <!-- 9. Buy 90-day VIP (disabled) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuy90d"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    app:icon="@drawable/ic_card_giftcard"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconTint="?attr/colorOnSurfaceVariant"
                    android:textColor="?attr/colorOnSurface"
                    android:enabled="false"
                    app:cornerRadius="16dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp"
                    android:text="@string/vip_buy_90d_locked"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:layout_marginTop="8dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:textAllCaps="false" />

                <!-- 10. Buy 1-year VIP (disabled) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuy1y"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    app:icon="@drawable/ic_card_giftcard"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconTint="?attr/colorOnSurfaceVariant"
                    android:textColor="?attr/colorOnSurface"
                    android:enabled="false"
                    app:cornerRadius="16dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp"
                    android:text="@string/vip_buy_1y_locked"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:layout_marginTop="8dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:textAllCaps="false" />

                <!-- 11. Buy lifetime VIP (disabled) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuyLifetime"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    app:icon="@drawable/ic_card_giftcard"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconTint="?attr/colorOnSurfaceVariant"
                    android:textColor="?attr/colorOnSurface"
                    android:enabled="false"
                    app:cornerRadius="16dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp"
                    android:text="@string/vip_buy_lifetime_locked"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:layout_marginTop="8dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:textAllCaps="false" />

                <!-- 13. Restore Purchase (disabled) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRestorePurchase"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    app:icon="@drawable/ic_restore"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconTint="?attr/colorPrimary"
                    android:textColor="?attr/colorPrimary"
                    android:enabled="false"
                    android:text="@string/vip_restore_locked"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:layout_marginTop="8dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:textAllCaps="false" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Privacy Policy footer -->
                <TextView
                    android:id="@+id/tvPrivacyPolicy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/privacy_policy"
                    android:textColor="?android:attr/textColorLink"
                    android:layout_marginTop="24dp"
                    android:padding="8dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
</FrameLayout>
