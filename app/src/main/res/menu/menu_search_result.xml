<?xml version="1.0" encoding="utf-8"?>
<!-- SEARCH-003: a deliberately smaller menu than menu_app.xml - only the actions that make
     sense on a transient search result (no stable grid position, so no favorite/folder/move). -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/menuItemElementAppInfo"
        android:icon="@drawable/ic_info_outline_24dp"
        android:title="@string/menu_app_info"
        app:iconTint="?attr/colorOnSurface" />

    <item
        android:id="@+id/menuItemPinStart"
        android:icon="@drawable/ic_pin_top_24dp"
        android:title="@string/organization_pin_start"
        app:iconTint="?attr/colorOnSurface" />

    <item
        android:id="@+id/menuItemPinEnd"
        android:icon="@drawable/ic_pin_bottom_24dp"
        android:title="@string/organization_pin_end"
        app:iconTint="?attr/colorOnSurface" />

    <item
        android:id="@+id/menuItemUnpin"
        android:icon="@drawable/ic_close_24dp"
        android:title="@string/organization_unpin"
        app:iconTint="?attr/colorOnSurface" />

    <item
        android:id="@+id/menuItemElementUninstall"
        android:icon="@drawable/ic_delete_outline_24dp"
        android:title="@string/menu_app_uninstall"
        app:iconTint="?attr/colorOnSurface" />

    <!-- FEAT-009: only visible when the adapter is constructed with onRemoveFromRecent (the
         recent-apps panel) - hidden in the search-overlay usage. -->
    <item
        android:id="@+id/menuItemRemoveFromRecent"
        android:icon="@drawable/ic_history_off_24dp"
        android:title="@string/remove_from_recent"
        app:iconTint="?attr/colorOnSurface" />

</menu>
