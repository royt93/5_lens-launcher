<?xml version="1.0" encoding="utf-8"?>
<!-- REL-002: Android 12+ cloud backup and device transfer share the same exclusions. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vip_screen_prefs.xml" />
        <exclude domain="sharedpref" path="app_search_history.xml" />
        <exclude domain="sharedpref" path="app_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vip_screen_prefs.xml" />
        <exclude domain="sharedpref" path="app_search_history.xml" />
        <exclude domain="sharedpref" path="app_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
